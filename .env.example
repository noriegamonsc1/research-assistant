# Backend: "api" (default, needs ANTHROPIC_API_KEY and Console credit) or
# "claude-cli" (uses your Claude Code login; counts against your Claude plan, no API key needed)
RESEARCH_ASSISTANT_BACKEND=api
RESEARCH_ASSISTANT_CLI_MODEL=opus
RESEARCH_ASSISTANT_CLI_BULK_MODEL=opus

# Required for the api backend only
ANTHROPIC_API_KEY=
# Polite-pool contact for OpenAlex / Crossref / NCBI (your own email)
CONTACT_EMAIL=

# Optional
S2_API_KEY=
NCBI_API_KEY=
RESEARCH_ASSISTANT_MODEL=claude-opus-5-5
RESEARCH_ASSISTANT_BULK_MODEL=claude-opus-5-5
RESEARCH_ASSISTANT_FALLBACK=1
